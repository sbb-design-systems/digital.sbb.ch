<!DOCTYPE html>
<html lang="{{ translations[page.lang].shortcode }}" dir="{{ translations[page.lang].dir }}" class="sbb-scrollbar-thick">
  <head>
    {% include "../_includes/head.njk" %}
  </head>
  <body>
    {# Name des Design Systems für Header-Buttons und Sidebar-Titel #}
    {% if system == "patternlibrary" %}{% set dsName = "Patterns" %}{% else %}{% set dsName = system | capitalizeWords %}{% endif %}
    {% include "../_includes/skiplinks.njk" %}
    {% include "../_includes/header/header.njk" %}
    {% if layout == "component.njk" or layout == "template.njk" %}
    <sbb-sidebar-container>
      <sbb-sidebar role="navigation" position="start" color="milk" mode="over" focus-on-open id="sidebar">
        <sbb-sidebar-title>{{ translations[page.lang].findcomponent | replace("{name}", dsName) }}</sbb-sidebar-title>
        <sbb-sidebar-close-button></sbb-sidebar-close-button>
        {% include "../_includes/browser/browser.njk" %}
      </sbb-sidebar>
      <sbb-sidebar-content class="sbb-scrollbar-thick">
    {% endif %}
        {% include "../_includes/navigation/navigation.njk" %}
        {% if layout == "landingpage.njk" or layout == "template.njk" %}
          {{ content | safe }}
        {% else %}
          <sbb-container id="content" class="content" role="main">
          {{ content | safe }}
          </sbb-container>
        {% endif %}  
        {% include "../_includes/footer.njk" %}
    {% if layout == "component.njk" or layout == "template.njk" %}
      </sbb-sidebar-content>
    </sbb-sidebar-container>
    {% endif %}
    <script type="module" src="{{ '/assets/js/lyne-bundle.js' | assetHash }}"></script>
    {#%<script src="{{ '/assets/js/mode-switch.js' | assetHash }}" defer></script>%#}

    {% if layout == "overview.njk" or layout == "overview.njk" %}
    <script src="{{ '/assets/js/component-browser.js' | assetHash }}" defer></script>
    {% endif %}

    {% if layout == "template.njk" %}
    <script src="{{ '/assets/js/template-browser.js' | assetHash }}" defer></script>
    <script src="{{ '/assets/js/sidebar.js' | assetHash }}" defer></script>
    <script src="{{ '/assets/js/component-browser.js' | assetHash }}" defer></script>
    {% endif %}

    {% if layout == "component.njk" %}
    <script src="{{ '/assets/js/mode-toggle.js' | assetHash }}" defer></script>
    <script src="{{ '/assets/js/sidebar.js' | assetHash }}" defer></script>
    <script src="{{ '/assets/js/component-browser.js' | assetHash }}" defer></script>
    {# highlight.js nur laden, wenn die Seite Codeblöcke oder Storybook-Beispiele (HTML-Snippets) enthält #}
    {% if ('<pre' in content) or ('iframe-border' in content) %}
    <script src="{{ '/assets/js/highlight.min.js' | assetHash }}" defer></script>
    <script>document.addEventListener("DOMContentLoaded", () => hljs.highlightAll());</script>
    {% endif %}
    {% endif %}
  </body>
</html>

