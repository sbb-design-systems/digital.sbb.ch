<sbb-lead-container>
  <sbb-image slot="image" image-src="{{image}}"></sbb-image>
  {% include "src/_includes/title.njk" %}

  <div class="role-chooser">
    <span class="sbb-text-xs sbb-text--bold">
    I am a
  </span>
    <sbb-tag-group class="" size="m">
      <sbb-tag value="content-1" checked>
      Product-Owner
    </sbb-tag>
      <sbb-tag id="tooltip-trigger-dev" value="content-2" disabled>
