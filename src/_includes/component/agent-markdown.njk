{#- Markdown-Version einer Lyne-Komponentenseite für Agents (…/index.md). Erwartet: component, lang -#}
{%- set pattern = lyne.components[component] -%}
{%- set config = pattern.config -%}
{%- set base = "https://digital.sbb.ch/" + lang + "/design-system/lyne/" + (config.list | slugify) + "/" -%}
{%- set t = {
  "de": { "intro": "Komponente des SBB Design Systems Lyne", "elements": "Elemente", "documentation": "Gestaltungsrichtlinien", "complete": "vollständig", "in progress": "in Arbeit", "missing": "fehlen noch", "not required": "nicht erforderlich (internes Hilfselement)", "experimental": "experimentell", "package": "Paket", "categories": "Kategorien", "status": "Status", "links": "Links", "page": "Seite auf digital.sbb.ch", "related": "Verwandte Komponenten", "similar": "Ähnlich", "overview": "Übersicht", "anatomy": "Anatomie", "implementation": "Implementation (Web Components, Englisch)", "api": "API (Web Components, Englisch)", "angular": "Angular", "apiHint": "Vollständige API-Tabellen (Attribute, Events, Slots, CSS-Eigenschaften)", "content": "Inhalt", "alsoAs": "auch als", "partHint": "nur innerhalb von", "groupedBy": "mehrere lassen sich zusammenfassen mit", "structure": "Aufbau", "single": "ein Element", "composite": "Hauptelement mit Bestandteilen; Bestandteile nur innerhalb des jeweiligen Elements verwenden", "grouped": "ein Element mit optionaler Gruppierung", "collection": "mehrere eigenständige Elemente" },
  "en": { "intro": "Component of the SBB design system Lyne", "elements": "Elements", "documentation": "design guidelines", "complete": "complete", "in progress": "in progress", "missing": "not yet available", "not required": "not required (internal helper)", "experimental": "experimental", "package": "Package", "categories": "Categories", "status": "Status", "links": "Links", "page": "Page on digital.sbb.ch", "related": "Related components", "similar": "Similar", "overview": "Overview", "anatomy": "Anatomy", "implementation": "Implementation (web components)", "api": "API (web components)", "angular": "Angular", "apiHint": "Full API tables (attributes, events, slots, CSS properties)", "content": "Content", "alsoAs": "also as", "partHint": "only within", "groupedBy": "several can be combined with", "structure": "Structure", "single": "one element", "composite": "main element with parts; use parts only within the element they belong to", "grouped": "one element with optional grouping", "collection": "several elements that can be used on their own" }
}[lang] -%}
{%- set dataPath = "_data/lyne/components/" + component + "/" -%}
{%- set storybook = lyne.catalog.groups[component].storybook.docsUrl if lyne.catalog.groups[component] and lyne.catalog.groups[component].storybook -%}
{%- set group = lyne.catalog.groups[component] -%}
{%- set documentation = component | lyneDocumentationStatus(config) -%}

# {{ config.tag | capitalizeWords }}

{{ t.intro }}.

- {{ t.package }}: `{{ group.package if group else "@sbb-esta/lyne-elements" }}` (Angular: `@sbb-esta/lyne-angular`)
{%- if group %}
- {{ t.structure }}: {{ t[group.structure] }}
{%- endif %}
{%- if config.categories | length %}
- {{ t.categories }}: {{ config.categories | join(", ") }}
{%- endif %}
- {{ t.status }}: {{ t.documentation | capitalize }} {{ t[documentation] }}{% if group and group.experimental %}, **{{ t.experimental }}**{% endif %}

## {{ t.links }}

- {{ t.page }}: {{ base }}{{ config.tag | slugify }}/
{%- if storybook %}
- Storybook: {{ storybook }}
{%- endif %}
{%- if group and group.angularUrl %}
- {{ t.angular }} (`{{ "@sbb-esta/lyne-angular-experimental" if group.experimental else "@sbb-esta/lyne-angular" }}`): {{ group.angularUrl }}/overview (API: {{ group.angularUrl }}/api)
{%- endif %}
{%- if config | figmaUrl %}
- Figma: {{ config | figmaUrl }}
{%- endif %}
- GitHub: {{ group.sourceUrl if group and group.sourceUrl else "https://github.com/sbb-design-systems/lyne-components" }}

{#- Elemente als verschachtelte Liste: Hauptelemente, Varianten, Gruppierung, Bestandteile #}
{%- macro elementItem(node, parentTag, indent) %}
{{ indent }}- `{{ node.tag }}`{% if node.variants | length %} ({{ t.alsoAs }} {% for variant in node.variants %}`{{ variant }}`{% if not loop.last %}, {% endif %}{% endfor %}){% endif %}{% if parentTag %}, {{ t.partHint }} `{{ parentTag }}`{% endif %}{% if node.groupedBy %}, {{ t.groupedBy }} `{{ node.groupedBy }}`{% endif %}{% if node.summary %}: {{ node.summary | safe }}{% endif %}
{%- for part in node.parts %}{{ elementItem(part, node.tag, indent + "  ") }}{% endfor %}
{%- endmacro %}
{%- if group %}

## {{ t.elements }}
{% for node in group.main %}{{ elementItem(node, null, "") }}{% endfor %}
{%- endif %}

{%- set computed = component | lyneRelations(lyne) %}
{%- set relations = [["similar", computed.similar]] %}
{%- set hasRelations = computed.similar | length %}
{%- if hasRelations %}

## {{ t.related }}
{% for relation in relations %}
{%- if relation[1] | length %}
- {{ t[relation[0]] }}: {% for item in relation[1] %}[{{ item.label }}]({{ base }}{{ item.key }}/index.md){% if not loop.last %}, {% endif %}{% endfor %}
{%- endif %}
{%- endfor %}
{%- endif %}

{%- set overviewSource = ((dataPath + "overview_" + lang + ".md") | readSourceFile) + "\n" + ((dataPath + "rules_" + lang + ".md") | readSourceFile) %}
{%- set overview = overviewSource | agentMarkdown %}
{%- if overview %}

## {{ t.overview }}

{{ overview | demoteHeadings | safe }}
{%- endif %}

{%- set content = (dataPath + "content_" + lang + ".njk") | readSourceFile | agentMarkdown %}
{%- if content %}

## {{ t.content }}

{{ content | demoteHeadings | safe }}
{%- endif %}

{%- set anatomy = (dataPath + "anatomy_" + lang + ".md") | readSourceFile | agentMarkdown %}
{%- if anatomy %}

## {{ t.anatomy }}

{{ anatomy | demoteHeadings | safe }}
{%- endif %}

{%- set usage = lyne.readmes[component] | readmeSection("usage") %}
{%- if usage | trim %}

## {{ t.implementation }}

{{ usage | agentMarkdown | demoteHeadings | safe }}
{%- endif %}

{%- set api = lyne.readmes[component] | readmeSection("api") %}
{#- Die API-Tabellen stehen in api.md (agent-api-markdown.njk), index.md und das Bündel verweisen darauf #}
{%- if (api | trim) %}

## {{ t.api }}

{{ t.apiHint }}: {{ base }}{{ config.tag | slugify }}/api.md
{%- endif %}
