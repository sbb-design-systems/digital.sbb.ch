{# Storybook-Titel: für Lyne aus dem Katalog (Ordnername), sonst aus der config #}
{% set catalogGroup = lyne.catalog.groups[component] if system == "lyne" %}
{% set storybookTag = catalogGroup.storybook.tag if (catalogGroup and catalogGroup.storybook) else pattern.config.storybookId %}
{# Lyne: vollständiger Titel (z. B. "elements/Pearl Chain"), weil derselbe Name auch unter "experimental/" vorkommen kann #}
{% set storybookTitle = catalogGroup.storybook.title if (catalogGroup and catalogGroup.storybook) else null %}
{% for storybookStory, story in storybookStories %}
{% if ((story.title == storybookTitle) if storybookTitle else (story.tag == storybookTag)) and story.component == true %}
<sbb-title level="3" visual-level="5">{{story.name}}.</sbb-title>
    <div class="example">
        <iframe id="{{story.id}}" class="iframe-border" loading="lazy" src="https://lyne-elements.app.sbb.ch/iframe.html?args=&id={{story.id}}&viewMode=story" title="{{story.name}}"></iframe>
        <div class="example-footer">
            <sbb-action-group orientation="vertical" button-size="m" horizontal-from="small" class="lyne-demo-example-button">
                <sbb-secondary-button-link size="m" icon-name="book-small" href="https://lyne-elements.app.sbb.ch/?path=/story/{{story.id}}" target="_blank">{{ componentTranslations["storybooklink"] }}</sbb-secondary-button-link>
                <sbb-secondary-button size="m" data-iframeid="{{story.id}}" icon-name="clipboard-list-small"></sbb-secondary-button>
                <sbb-toggle-check data-codetoggle="{{story.id}}" size="m" label-position="after">{{ componentTranslations["showhtml"] }}</sbb-toggle-check>
            </sbb-action-group>
        </div>
    </div>
{% endif %}
{% endfor %}
<sbb-toast id="clipboard-toast" position="bottom-center" timeout="3000" politeness="polite" icon-name="circle-tick-small">{{ componentTranslations["copyhtml"] }}</sbb-toast>