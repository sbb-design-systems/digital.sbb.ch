{#- Beispiele aus Storybook. Das Markup aus playground.html steht als Vorschau im Übersichts-Tab (tab-overview.njk). #}
{% if pattern.config.tabs.hasStorybook == true %}
    <sbb-tab-label level="2" role="tab" slot="tab-bar">
        <sbb-icon name="{{tabs[2].icon}}" slot="icon"></sbb-icon>
        {{ tabs[2].label[language] if system == "lyne" else "Demo" }}
    </sbb-tab-label>
    <sbb-tab>
        {% include "./storybook-story.njk" %}
        <script src="{{ '/assets/js/lyne-examples.js' | assetHash }}" defer></script>
    </sbb-tab>
{% endif %}
