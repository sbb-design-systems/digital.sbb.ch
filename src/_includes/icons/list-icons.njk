{% for category in categories %}
<sbb-title level="3" visual-level="4" id="{{category}}" data-category="{{category}}" data-id="id-{{category}}" data-name="{{category}}" data-size="title">{{category}}</sbb-title>
{% for icon in icons %}{% if category == icon.category %}{% include "./item.njk" %}{% endif %}{% endfor %}
{% endfor %}

