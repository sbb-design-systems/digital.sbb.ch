<sbb-popover id="icon-popover" hover-trigger data-label-category="{{ translations[page.lang].iconcategory }}" data-label-tags="{{ translations[page.lang].icontags }}">
    <div class="icon-content">
        <sbb-title level="5" class="icon-content-title"></sbb-title>
        <p class="sbb-text-xs popover-max-width icon-content-meta"></p>
        <div class="icon-items"></div>
    </div>
</sbb-popover>
<sbb-toast id="icon-toast" timeout="3000" data-label-copied="{{ translations[page.lang].iconcopied }}"></sbb-toast>
